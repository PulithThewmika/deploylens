{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Services",
      "description": "Total registered services.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kubex-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM services"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Deploys Today",
      "description": "Deployments completed today across all services (dora_deploy_frequency).",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kubex-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COALESCE(SUM(deploy_count), 0) AS value\nFROM dora_deploy_frequency\nWHERE deploy_date = CURRENT_DATE"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Alerts",
      "description": "Currently unresolved alerts (alerts.resolved_at IS NULL).",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kubex-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM alerts WHERE resolved_at IS NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Worst Current Health Score",
      "description": "Lowest latest health_assessments.score across all services.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kubex-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT MIN(latest_score) AS value\nFROM (\n  SELECT DISTINCT ON (d.service_id) ha.score AS latest_score\n  FROM health_assessments ha\n  JOIN deployments d ON d.id = ha.deployment_id\n  ORDER BY d.service_id, ha.assessed_at DESC\n) t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Services",
      "description": "All services with their last deploy time and most recent health verdict/score. Click a row to drill into Service Deep Dive.",
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 6 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kubex-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  s.name AS service,\n  (\n    SELECT MAX(d2.finished_at)\n    FROM deployments d2\n    WHERE d2.service_id = s.id AND d2.finished_at IS NOT NULL\n  ) AS last_deploy,\n  latest.verdict,\n  latest.score AS health_score\nFROM services s\nLEFT JOIN LATERAL (\n  SELECT ha.verdict, ha.score\n  FROM health_assessments ha\n  JOIN deployments d ON d.id = ha.deployment_id\n  WHERE d.service_id = s.id\n  ORDER BY ha.assessed_at DESC\n  LIMIT 1\n) latest ON true\nORDER BY s.name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Service Deep Dive",
              "url": "/d/service-deep-dive/service-deep-dive?var-service=${__data.fields.service}&from=${__from}&to=${__to}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "verdict" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "healthy": { "text": "healthy", "color": "green" } } },
                  { "type": "value", "options": { "degraded": { "text": "degraded", "color": "orange" } } },
                  { "type": "value", "options": { "failed": { "text": "failed", "color": "red" } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "health_score" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "gauge", "mode": "basic" }
              },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "orange", "value": 50 },
                    { "color": "green", "value": 80 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "service", "desc": false }],
        "footer": { "show": false }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Active Alerts",
      "description": "Currently unresolved alerts, most recent first.",
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 6 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kubex-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  a.fired_at,\n  s.name AS service,\n  a.severity,\n  a.title\nFROM alerts a\nJOIN services s ON s.id = a.service_id\nWHERE a.resolved_at IS NULL\nORDER BY a.fired_at DESC\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "severity" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "critical": { "text": "critical", "color": "red" } } },
                  { "type": "value", "options": { "warning": { "text": "warning", "color": "orange" } } }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "fired_at", "desc": true }],
        "footer": { "show": false }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent Safety Scores",
      "description": "Pre-deploy safety scores (rule-based, not ML) computed on workflow_run.requested, most recent first.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kubex-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  ss.computed_at,\n  s.name AS service,\n  ss.deployment_id,\n  ss.score,\n  ss.risk_factors\nFROM safety_scores ss\nJOIN deployments d ON d.id = ss.deployment_id\nJOIN services s ON s.id = d.service_id\nORDER BY ss.computed_at DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "score" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "gauge", "mode": "basic" }
              },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 40 },
                    { "color": "red", "value": 70 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "computed_at", "desc": true }],
        "footer": { "show": false }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["kubex", "platform-overview"],
  "templating": {
    "list": []
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Platform Overview",
  "uid": "platform-overview",
  "version": 1,
  "weekStart": ""
}
