{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Deployment Frequency",
      "description": "Average deploys/day over the selected window (dora_deploy_frequency).",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "deploylens-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT\n  deploy_date AS time,\n  SUM(deploy_count) AS value\nFROM dora_deploy_frequency\nWHERE ('$service' = '.*' OR service_name = '$service')\n  AND $__timeFilter(deploy_date)\nGROUP BY deploy_date\nORDER BY deploy_date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Lead Time for Changes (median)",
      "description": "Median seconds from commit to deploy (dora_lead_time, percentile_cont(0.5)).",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "deploylens-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY lead_time_seconds) AS value\nFROM dora_lead_time\nWHERE ('$service' = '.*' OR service_name = '$service')\n  AND $__timeFilter(finished_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Change Failure Rate",
      "description": "% of deployments that failed or were assessed degraded/failed (dora_change_failure_rate).",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "deploylens-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  ROUND(\n    COUNT(*) FILTER (WHERE is_failure)::numeric / NULLIF(COUNT(*), 0) * 100,\n    1\n  ) AS value\nFROM dora_change_failure_rate\nWHERE ('$service' = '.*' OR service_name = '$service')\n  AND $__timeFilter(started_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["deploylens", "dora-scorecard"],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "deploylens-postgres"
        },
        "query": "SELECT name FROM services ORDER BY name",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ".*" }
      }
    ]
  },
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "DORA Scorecard",
  "uid": "dora-scorecard",
  "version": 1,
  "weekStart": ""
}
