{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "ArgoCD Sync Status",
      "description": "Current ArgoCD application health status (argocd_app_health_status). Only the status currently at value 1 is shown.",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "deploylens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "argocd_app_health_status{name=~\"$service\"} == 1",
          "legendFormat": "{{health_status}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "name"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Build Duration Trend",
      "description": "build_duration_s per deploy, most recent deploys first.",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "deploylens-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT\n  d.started_at AS time,\n  d.build_duration_s AS value,\n  s.name AS metric\nFROM deployments d\nJOIN services s ON s.id = d.service_id\nWHERE d.build_duration_s IS NOT NULL\n  AND ('$service' = '.*' OR s.name = '$service')\n  AND $__timeFilter(d.started_at)\nORDER BY d.started_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "pointSize": 5,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU Usage",
      "description": "Container CPU usage in cores.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": {
        "type": "prometheus",
        "uid": "deploylens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"$environment\", container=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory Usage",
      "description": "Container working-set memory.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": {
        "type": "prometheus",
        "uid": "deploylens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"$environment\", container=~\"$service\"})",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error Log Volume",
      "description": "Count of log lines matching \"error\" (case-insensitive) per 5m, since Fluent-Bit does not attach a level label.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": {
        "type": "loki",
        "uid": "deploylens-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (count_over_time({namespace=\"$environment\", container=~\"$service\"} |~ \"(?i)error\" [5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 30,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Live Log Stream",
      "description": "Raw container log stream from Loki.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": {
        "type": "loki",
        "uid": "deploylens-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"$environment\", container=~\"$service\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Health Score History",
      "description": "health_assessments.score over time per deployment.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "deploylens-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT\n  ha.assessed_at AS time,\n  ha.score AS value,\n  s.name AS metric\nFROM health_assessments ha\nJOIN deployments d ON d.id = ha.deployment_id\nJOIN services s ON s.id = d.service_id\nWHERE ('$service' = '.*' OR s.name = '$service')\n  AND $__timeFilter(ha.assessed_at)\nORDER BY ha.assessed_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "pointSize": 5,
            "showPoints": "always"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["deploylens", "service-deep-dive"],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "deploylens-postgres"
        },
        "query": "SELECT name FROM services ORDER BY name",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ".*" }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "sample-app",
        "current": { "text": "sample-app", "value": "sample-app" },
        "options": [
          { "text": "sample-app", "value": "sample-app", "selected": true }
        ]
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Service Deep Dive",
  "uid": "service-deep-dive",
  "version": 1,
  "weekStart": ""
}
