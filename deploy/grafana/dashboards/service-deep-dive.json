  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "ArgoCD Sync Status",
      "description": "Current ArgoCD application health status (argocd_app_health_status). Only the status currently at value 1 is shown.",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "deploylens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "argocd_app_health_status{name=~\"$service\"} == 1",
          "legendFormat": "{{health_status}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "name"
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["deploylens", "service-deep-dive"],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "deploylens-postgres"
        },
        "query": "SELECT name FROM services ORDER BY name",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ".*" }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "sample-app",
        "current": { "text": "sample-app", "value": "sample-app" },
        "options": [
          { "text": "sample-app", "value": "sample-app", "selected": true }
        ]
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Service Deep Dive",
  "uid": "service-deep-dive",
